{
	"name": "hjh3311504-github-io",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"postbuild": "npm run optimize-images",
		"preview": "sirv build --dev",
		"test": "npm run test:team-maker",
		"test:team-maker": "node --test tests/team-maker/*.test.js",
		"pretest:e2e:team-maker": "npm run build",
		"test:e2e:team-maker": "env -u NO_COLOR playwright test",
		"verify:team-maker": "node scripts/verify_team_maker_build.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"optimize-images": "node scripts/optimize_images.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@typescript-eslint/parser": "^8.68.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.103.1",
		"sharp": "^0.35.4",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/inter": "^4.5.15"
	},
	"homepage": "https://hjh3311504.github.com"
}
